<Window x:Class="Day9_BindingINotify_UDT_XACT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Day9_BindingINotify_UDT_XACT"
        mc:Ignorable="d"
        Title="Person Binding" Height="600" Width="800"
        Background="Orange">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="190"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Code part -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical" Margin="5">
            <StackPanel.Resources>
                <Style TargetType="Label">
                    <Setter Property="Foreground" Value="green"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </StackPanel.Resources>
            <Label Content="Person Details" Margin="5"/>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="Id"  Width="80"/>
                <ComboBox x:Name="cmbCode" Width="300" SelectionChanged="cmbCode_SelectionChanged"
                          ItemsSource="{Binding PersonList}" DisplayMemberPath="DisplayText" 
                          SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="Naam"  Width="80"/>
                <TextBox Text="{Binding SelectedPerson.Name, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <Label Content="Thegana"  Width="80"/>
                <TextBox Text="{Binding SelectedPerson.Address, UpdateSourceTrigger=PropertyChanged}"  Width="300"/>
            </StackPanel>
        </StackPanel>

        <!-- Image part -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" >
            <Image x:Name="imgPhoto" Source="{Binding SelectedPerson.Photo}" Width="140" Height="140" MouseDown="imgPhoto_MouseDown" Cursor="Hand" Margin="5"/>
            <Label Content="Click image to upload" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5"/>
        </StackPanel>

        <!-- Qualification Part -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="5">
            <Label Content="Qualification"/>
            <DataGrid x:Name="dgQualification" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="S.N" Binding="{Binding SNo}" Width="50"/>
                    <DataGridTextColumn Header="Department/Degree" Binding="{Binding Department}" Width="*"/>
                    <DataGridTextColumn Header="University" Binding="{Binding University}" Width="*"/>
                    <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Buttons part-->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Save" Click="btnSave_Click" Width="80" Margin="5" Background="Green"/>
            <Button Content="Delete" Click="btnDelete_Click" Width="80" Background="OrangeRed" Margin="5"/>
            <Button Content="Reset" Click="btnReset_Click" Width="80" Margin="5"/>
            <Button Content="Async" Click="btnAsync_Click" Width="80" Margin="5" Background="Transparent"/>
        </StackPanel>
    </Grid>
</Window>
