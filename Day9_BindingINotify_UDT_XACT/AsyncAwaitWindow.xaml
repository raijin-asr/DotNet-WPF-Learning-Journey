<Window x:Class="Day9_BindingINotify_UDT_XACT.AsyncAwaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Day9_BindingINotify_UDT_XACT"
        mc:Ignorable="d"
        Title="AsyncAwaitWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="lblLoad" Content="Loading window..." FontSize="16" Foreground="red" Margin="5"/>
            <TextBlock x:Name="StatusText" FontSize="16" Text="Click the button to load data." TextAlignment="Center" Margin="5"/>
            <Button x:Name="LoadButton" Content="Load Data(Async)" Width="120" Click="LoadButton_Click" Margin="5"/>
            <TextBox x:Name="OutputBox" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <Button x:Name="SyncCounterButton" Content="Increase Sync Count" Width="150" Click="SyncCounterButton_Click" Margin="5"/>
            <Label x:Name="lblSyncCount" Content="Count: 0" FontSize="16" Margin="5"/>

        </StackPanel>
    </Grid>
</Window>
