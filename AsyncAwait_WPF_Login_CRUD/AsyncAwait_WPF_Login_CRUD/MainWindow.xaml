<Window x:Class="AsyncAwait_WPF_Login_CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AsyncAwait_WPF_Login_CRUD"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="400"
        Loaded="Window_Loaded">
    
    <Grid Margin="20">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Login" FontSize="20" TextAlignment="Center" Margin="10"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Username:" FontSize="16"  Margin="5" Width="75"/>
                <TextBox x:Name="txtUsername" Width="250" Margin="3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Login" FontSize="16"  Margin="5" Width="75"/>
                <PasswordBox x:Name="txtPassword" Width="250" Margin="3"/>
            </StackPanel>
            <CheckBox x:Name="chkRemember" Content="Remember Me" Margin="5 7"/>
            <Button Content="Login" Click="Login_Click" Width="100" Height="40" Margin="5"  FontSize="18" FontWeight="SemiBold" Background="Green" Foreground="White" BorderBrush="Black" BorderThickness="1" Cursor="Hand"/>
            <TextBlock HorizontalAlignment="Center">
                Don't have an account?
                <Hyperlink Click="SignupLink_Click" > Sign up</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
