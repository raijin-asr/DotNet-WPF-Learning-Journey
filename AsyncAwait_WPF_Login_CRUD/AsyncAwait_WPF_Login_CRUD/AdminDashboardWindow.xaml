<Window x:Class="AsyncAwait_WPF_Login_CRUD.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AsyncAwait_WPF_Login_CRUD"
        mc:Ignorable="d"
        Title="AdminDashboardWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Welcome " FontSize="20"/>
            <TextBlock x:Name="lblName" Text="{Binding Name}" FontWeight="Bold" FontSize="20"/>
        </StackPanel>
    </Grid>
</Window>
