<Window x:Class="AsyncAwait_WPF_Login_CRUD.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AsyncAwait_WPF_Login_CRUD"
        mc:Ignorable="d"
        Title="SignupWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sign Up"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#333333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>
        <Label Grid.Row="1"
           Content="Name"
           FontSize="14"
           Foreground="#555555"
           Margin="6 0"/>

        <TextBox x:Name="txtName"
             Grid.Row="2"
             Height="35"
             FontSize="16"
             Padding="8,0,0,0"
             BorderBrush="#CCCCCC"
             BorderThickness="1"
             VerticalContentAlignment="Center"
             Margin="10 0"/>

        <Label Grid.Row="3"
               Content="Username"
               FontSize="14"
               Foreground="#555555"
               Margin="6 0"/>

        <TextBox x:Name="txtUsername"
                 Grid.Row="4"
                 Height="35"
                 FontSize="16"
                 Padding="8,0,0,0"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"
                 VerticalContentAlignment="Center"
                 Margin="10 0"/>

        <Label Grid.Row="5"
               Content="Password"
               FontSize="14"
               Foreground="#555555"
               Margin="6 0"/>

        <PasswordBox x:Name="txtPassword"
                     Grid.Row="6"
                     Height="35"
                     FontSize="16"
                     Padding="8,0,0,0"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     Margin="10 0"/>

        <Button x:Name="SignupButton"
                Grid.Row="7"
                Content="Create Account"
                Height="45"
                Width="200"
                FontSize="18"
                Margin="10"
                FontWeight="SemiBold"
                Background="#007ACC" Foreground="White"
                BorderBrush="#007ACC"
                BorderThickness="1"
                Cursor="Hand"
                Click="SignupButton_Click">
        </Button>
    </Grid>
</Window>
