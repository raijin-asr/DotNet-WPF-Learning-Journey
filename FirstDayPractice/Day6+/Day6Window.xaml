<Window x:Class="FirstDayPractice.Day6_.Day6Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstDayPractice.Day6_"
        mc:Ignorable="d"
        Title="Day6Window" Height="450" Width="800">

    <!--mergerd resource dictionary-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Color.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="5">
        <TabControl x:Name="MainTabControl">
            <TabItem Header="Tab 1">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Background="LightBlue" Orientation="Vertical" Margin="5">
                        <TextBlock Text="Routed Events" Margin="5" FontWeight="Bold"/>
                        <StackPanel Background="LightBlue" Orientation="Horizontal" Button.Click="YesNoCancelButton_Click" >
                            <Button Name="YesButton" Width="50" Margin="5">Yes</Button>
                            <Button Name="NoButton" Width="50"  Margin="5" Background="white">No</Button>
                            <Button Name="CancelButton" Width="50" Margin="5">Cancel</Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Background="LightGreen" MouseDown="BubblingPanel_MouseDown" Margin="5">
                        <TextBlock Text="Bubbling" Margin="5" FontWeight="Bold"/>
                        <Button Content="Click Me" Margin="10"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Background="LightCoral" PreviewMouseDown="TunnelingPanel_PreviewMouseDown" Margin="5">
                        <TextBlock Text="Tunneling(Preview)" Margin="5" FontWeight="Bold"/>
                        <Button Content="Click Me" Margin="10"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Background="Yellow" Button.Click="Button_Click_StackPanel" Margin="5">
                        <TextBlock Text="Handled" Margin="5" FontWeight="Bold"/>
                        <Button Content="Click Me" Margin="10" Click="Button_CLick_Button"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Background="Yellow" PreviewMouseDown="StackPanel_PreviewMouseDown" MouseDown="StackPanel_MouseDown" Margin="5">
                        <TextBlock Text="Compostie Control and both event" Margin="5" FontWeight="Bold"/>
                        <Button Content="Click Me" Margin="10" PreviewMouseDown="Button_PreviewMouseDown" MouseDown="Button_MouseDown"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Background="red" Margin="5">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <EventSetter Event="Click" Handler="ApplyButtonStyle"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="EventSetter" Margin="5" TextAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="white"/>
                        <Button Margin="5">Click me (event styled)</Button>
                        <Button Click="Direct_Button_Click" Margin="5">Click me (direct handler)</Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2"  Name="EventPanel" Background="LightGray"  Margin="5">
                        <TextBlock Text="Event Manager(eg. Glow button)" Margin="5" FontWeight="Bold"/>
                        <local:FancyButton Content="Click me" GlowChanged="FancyButton_GlowChanged" Width="150" Height="40" Margin="5"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Background="FloralWhite"  Margin="5">
                        <TextBlock Text="Input Events" Margin="5" FontWeight="Bold"/>
                        <Button Content="focus me and press key" KeyDown="OnButtonKeyDown"  Margin="10" />
                        <Button Content="Hover me and Leave" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave" Margin="10"/>

                        <StackPanel KeyDown="OnTextInputKeyDown" Background="FloralWhite"  Margin="5">
                            <Button Content="Click (Ctrl + O)" Click="OnTextInputButtonClick"  Margin="10"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Background="Orange"  Margin="5">
                        <TextBlock Text="Command" Margin="5" FontWeight="Bold"/>
                        <Button Content="Say Hello" Margin="10" Command="{x:Static local:Day6Window.SayHelloCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Background="white"  Margin="5">
                        <TextBlock Text="Resource Dictionary" TextWrapping="Wrap" Margin="5" FontWeight="Bold"/>
                        <Button Content="Say Hello" Margin="10" Background="{StaticResource BackgroundColorRD}"/>
                        <TextBlock Text="System Resource" TextWrapping="Wrap" Margin="5" FontWeight="Bold"/>
                        <TextBlock FontSize="{x:Static SystemFonts.CaptionFontSize}"
                                   FontWeight="{x:Static SystemFonts.CaptionFontWeight}"
                                   FontFamily="{x:Static SystemFonts.CaptionFontFamily}"
                                   Text="Static: System Font" Margin="5"/>
                        <TextBlock FontSize="{DynamicResource {x:Static SystemFonts.SmallCaptionFontSizeKey}}"
                                   FontWeight="{DynamicResource {x:Static SystemFonts.SmallCaptionFontWeightKey}}"
                                   FontFamily="{DynamicResource {x:Static SystemFonts.SmallCaptionFontFamilyKey}}"
                                   Text="Dynamic: System Font" Margin="5"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Tab 2">
            </TabItem>
        </TabControl>
    </Grid>
</Window>
