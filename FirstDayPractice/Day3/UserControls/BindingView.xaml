<UserControl x:Class="FirstDayPractice.Day3.UserControls.BindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FirstDayPractice.Day3.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- OUTER GRID WITH TWO COLUMNS -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- One Way Binding: LEFT COLUMN -->
        <Grid Grid.Column="0" Margin="10" Background="green">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="2" Content="One-Way Binding" Margin="5" FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="1" Content="Name" Margin="2"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="2"
                     Text="{Binding Name, Mode=OneWay}" />

            <Label Grid.Row="2" Content="_Age:" Margin="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="2"
                     Text="{Binding Age, Mode=OneWay}" />

            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="10">
                <Button Content="Test One" Width="100" Click="OneWayButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Two Way Binding: RIGHT COLUMN -->
        <Grid Grid.Column="1" Margin="10" Background="red">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Two-Way Binding" Margin="5" FontWeight="Bold" VerticalAlignment="Center"/>
            <Label Grid.Row="1" Content="Name:" Margin="2"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="2"
                     Text="{Binding Name, Mode=TwoWay}" />

            <Label Grid.Row="2" Content="_Age:" Margin="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="2"
                     Text="{Binding Age, Mode=TwoWay}" />

            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="10">
                <Button Content="Test Two" Width="100" Click="TwoWayButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
