<UserControl x:Class="FirstDayPractice.Day3.UserControls.TriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FirstDayPractice.Day3.UserControls"
             mc:Ignorable="d"  Background="white"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--Property Trigger-->
        <Style x:Key = "TriggerStyle" TargetType = "Button">
            <Setter Property = "Background" Value = "Blue" />
            <Setter Property = "Foreground" Value = "white" />
            <Style.Triggers>
                <Trigger Property = "IsMouseOver" Value = "True">
                    <Setter Property = "Background" Value = "Green" />
                    <Setter Property = "Foreground" Value = "black" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!--property trigger part-->
        <StackPanel Grid.Row="0"  Margin="10" Orientation="Horizontal" >
            <Label>Property Trigger: </Label>
            <Button  Width = "100" Height = "70" Style = "{StaticResource TriggerStyle}" Content = "Trigger"/>
        </StackPanel>

        <Border BorderBrush="black" BorderThickness="0,0,1,0" Margin="10,5"/>

        <!--event trigger part-->
         <StackPanel Grid.Row="0" Grid.Column="1" Margin="10" Orientation="Vertical">
            <Label>Event Trigger:</Label>
            <Button Content = "Click Me" Width = "60" Height = "30">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <EventTrigger.Actions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" From="60" To="200" Duration="0:0:1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Height" From="30" To="100" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger.Actions>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </StackPanel>
        
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="black" BorderThickness="0,1,0,1" Margin="10,5"/>

        <!--data trigger part-->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="10" Orientation="Vertical">
            <Label >Event Trigger:</Label>
            <CheckBox x:Name = "changeCheckBox" Content = "Set red as foreground color" Margin = "20"/>
            <TextBlock Name = "txtblock" VerticalAlignment = "Center" Text = "Text to Change" FontSize = "24" Margin = "20">
                <TextBlock.Style>
                    <Style>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=changeCheckBox, Path=IsChecked}" Value="True">
                                <Setter Property="TextBlock.Foreground" Value="red"/>
                                <Setter Property="TextBlock.Cursor" Value="Hand"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
