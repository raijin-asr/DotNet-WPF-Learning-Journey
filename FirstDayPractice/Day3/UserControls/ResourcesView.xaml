<UserControl x:Class="FirstDayPractice.Day3.UserControls.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FirstDayPractice.Day3.UserControls"
             mc:Ignorable="d"  Background="white"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key = "brushResource" Color = "LightGreen" />
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <Label>Box with Static Resource(does not change)</Label>
            <Rectangle Height = "50" Margin = "20 0 0 20" Fill = "{StaticResource brushResource}" />

            <Label>Box with Dynamic Resource(which changes when button clicked)</Label>
            <Rectangle Height = "50" Margin = "20 0 0 20"  Fill = "{DynamicResource brushResource}" />
            <Button x:Name = "changeResourceButton"
                    Width="100"
                    Height="50"
                    Background="Green"
                    Content = "Change Resource" 
                    Click = "changeResourceButton_Click" />
            <Label>Box applying Resource Dictionary(changes color when button clicked)</Label>
            <Rectangle Height = "50" Margin = "20 0 0 20" Fill = "{DynamicResource brushResourceDictionary}" />
            
            <Button x:Name = "changeResourceDictionaryButton"
                    Width="200"
                    Height="40"
                    Margin="10"
                    Background="red"
                    Content = "Change Dictionary Resource" 
                    Click = "changeResourceDictionaryButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
