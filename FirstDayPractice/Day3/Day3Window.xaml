<Window x:Class="FirstDayPractice.Day3.Day3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstDayPractice.Day3"
        mc:Ignorable="d"
        Title="Day3Window" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="SideMenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="borderStyle"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="borderStyle" Property="Background" Value="green"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Side menu -->
            <ColumnDefinition/>
            <!-- Main content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar menu -->
        <ListBox x:Name="SideMenu"
                 SelectionChanged="SideMenu_SelectionCHanged"
                 SelectedIndex="0"
                 Background="LightGray"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource SideMenuItemStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" Padding="10" FontSize="16" Foreground="black"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!--Content part-->
        <ContentControl Grid.Column="1" x:Name="ContentArea"/>
    </Grid>
</Window>
