<Page x:Class="FirstDayPractice.CalculatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FirstDayPractice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CalculatorPage"
      PreviewKeyDown="Page_PreviewKeyDown"
      Focusable="True"
      KeyboardNavigation.TabNavigation="None">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="Output" FontSize="32" Height="60" IsReadOnly="True"
     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
     Margin="0,0,0,10" Text="0" />


        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="1" Grid.Row="0" Grid.Column="0" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="2" Grid.Row="0" Grid.Column="1" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="3" Grid.Row="0" Grid.Column="2" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="←" Grid.Row="0" Grid.Column="3" FontSize="20" Click="Number_Click" Background="AntiqueWhite"/>

            <Button Content="4" Grid.Row="1" Grid.Column="0" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="5" Grid.Row="1" Grid.Column="1" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="6" Grid.Row="1" Grid.Column="2" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="C" Grid.Row="1" Grid.Column="3" FontSize="20" Click="Clear_Click" Background="red"/>

            <Button Content="7" Grid.Row="2" Grid.Column="0" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="8" Grid.Row="2" Grid.Column="1" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="9" Grid.Row="2" Grid.Column="2" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="=" Grid.Row="2" Grid.Column="3" FontSize="20" Click="Equals_Click" Background="Yellow"/>

            <Button Content="0" Grid.Row="3" Grid.Column="0" FontSize="20" Click="Number_Click" Background="white"/>
            <Button Content="." Grid.Row="4" Grid.Column="0" FontSize="20" Click="Number_Click" Background="NavajoWhite"/>
            
            <Button Content="+" Grid.Row="3" Grid.Column="1" FontSize="20" Click="Operator_Click" Background="green"/>
            <Button Content="-" Grid.Row="3" Grid.Column="2" FontSize="20" Click="Operator_Click" Background="green"/>
            <Button Content="x" Grid.Row="4" Grid.Column="1" FontSize="20" Click="Operator_Click" Background="green"/>
            <Button Content="/" Grid.Row="4" Grid.Column="2" FontSize="20" Click="Operator_Click" Background="green"/>


        </Grid>
    </Grid>
</Page>
