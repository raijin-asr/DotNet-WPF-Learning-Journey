<Page x:Class="FirstDayPractice.NewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FirstDayPractice"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="500"
      Title="NewPage">

    <Grid Margin="10,0,10,10">
        <Grid.Resources>
            <DataTemplate x:Key="personTemplate">
                <Label Content="{Binding XPath=@Name}"/>
            </DataTemplate>
            <XmlDataProvider x:Key="ReportDataSource" XPath="Reports">
                <x:XData>
                    <Reports xmlns="">
                        <Person Name="Ameer" Department="R&amp;D">
                            <Report Product="Desktop" Amount="1000"/>
                            <Report Product="Mouse" Amount="200"/>
                            <Report Product="Keyboard" Amount="300"/>
                        </Person>
                        <Person Name="Ram" Department="Sales">
                            <Report Product="Copy" Amount="120"/>
                            <Report Product="Pen" Amount="20"/>
                            <Report Product="Pencil" Amount="10"/>
                        </Person>
                        <Person Name="Yalung" Department="R&amp;D">
                            <Report Product="Monitor" Amount="2000"/>
                            <Report Product="Mouse" Amount="200"/>
                        </Person>
                    </Reports>
                </x:XData>
            </XmlDataProvider>
        </Grid.Resources>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="watermark.png"/>
        </Grid.Background>

        <Label Grid.Column="1" Style="{StaticResource headerTextStyle}">
            Welcome to New page!
        </Label>

        <!-- People list -->
        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource listHeaderStyle}">
            <Label Style="{StaticResource listHeaderTextStyle}">Names</Label>
        </Border>
        <ListBox Name="peopleListBox" Grid.Column="1" Grid.Row="2"
            ItemsSource ="{Binding Source={StaticResource ReportDataSource}, XPath=Person}"
            ItemTemplate="{StaticResource personTemplate}" RenderTransformOrigin="0.5,0.5">
           
        </ListBox>

        <!-- View report button -->
        <Button Grid.Row="3" Grid.Column="1"  Margin="10,10,0,10"  Click="Button_Click" Style="{StaticResource btnStyle}">View</Button>

        <Button Grid.Row="3"  Grid.Column="1" Content="Open Popup" Click="OpenPopup_CLick" Margin="5" Height="25" Width="110" HorizontalAlignment="Left" Background="red" Foreground="white"/>

    </Grid>
</Page>
