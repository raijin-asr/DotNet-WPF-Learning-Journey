<Application x:Class="FirstDayPractice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FirstDayPractice"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--style for mainWindow-->
        <SolidColorBrush x:Key="BackgroundColor" Color="LightGreen"></SolidColorBrush>

        <ControlTemplate x:Key="roundButton" TargetType="Button">
            <Grid>
                <Ellipse x:Name="ellipseBg" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" TargetName="ellipseBg" Value="black"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        
        <!--style for new page-->
        <Style x:Key="headerTextStyle"> <!--without TargetType-->
            <Setter Property="Label.FontFamily" Value="Trebuchet MS"></Setter>
            <Setter Property="Label.FontWeight" Value="Bold"></Setter>
            <Setter Property="Label.FontSize" Value="20"></Setter>
            <Setter Property="Label.Foreground" Value="#0066cc"></Setter>
            <Setter Property="Label.VerticalAlignment" Value="Center"></Setter>
        </Style>

        <Style x:Key="listHeaderStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="#4E87D4" />
        </Style>
        
        <Style x:Key="listHeaderTextStyle" TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <LinearGradientBrush x:Key="GrayBlueGradientBrush"
    StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="DarkGray" Offset="0" />
            <GradientStop Color="#CCCCFF" Offset="0.5" />
            <GradientStop Color="DarkGray" Offset="1" />
        </LinearGradientBrush>
        
        <Style x:Key="btnStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{StaticResource GrayBlueGradientBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" ClipToBounds="True">
                            <Rectangle 
                                 x:Name="outerRectangle"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Stroke="{TemplateBinding Background}"
                                 RadiusX="10"
                                 RadiusY="10"
                                 StrokeThickness="5"
                                 Fill="Transparent">
                                
                            </Rectangle>
                            <Rectangle 
                                 x:Name="innerRectangle"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Stroke="Transparent"
                     
                                 RadiusX="10"
                                 RadiusY="10"
                                 StrokeThickness="20"
                                 Fill="{TemplateBinding Background}">
                                
                            </Rectangle>               
                            <DockPanel x:Name="myDockPanel">
                                <ContentPresenter 
                                     x:Name="myContentPresenter" 
                                     Margin="5"
                                     Content= "{TemplateBinding Content}"
                                     TextBlock.Foreground="Black"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/> 
                            </DockPanel>
                        </Grid>
                        
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!--style for report page-->
        <Style x:Key="labelStyle" TargetType="{x:Type Label}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,5" />
           
        </Style>

        <Style x:Key="columnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="#4E87D4" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!--style for control practice window-->
        <Style x:Key="labelBold" TargetType="{x:Type Label}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>


        <!--resource dictionary practice-->
        <ResourceDictionary x:Key="resourceDict1" Source="Day3/UserControls/ResourceDictionaryPractice.xaml"/>
      
        
    </Application.Resources>
</Application>
