<Window x:Class="FirstDayPractice.Day4.MasterNewVisionDesign"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstDayPractice.Day4"
        mc:Ignorable="d"
        Title="VISION"
        SizeToContent="Manual"
        Width="1230"
        Height="700"
        WindowState="Maximized"
        Icon="Images/home.png"
        WindowStyle="None"
        AllowsTransparency="False"
        Foreground="white"
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="SteelBlue" Grid.Row="0" Margin="0" MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5" >
                <Image Source="pack://application:,,,/Day4/Images/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="VISION"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="14"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5">
                <Button Content="🗕" Width="30" Click="Minimize_Click" Margin="2"/>
                <Button Content="🗖" Width="30" Click="Maximize_Click" Margin="2"/>
                <Button Content="✖" Width="30" Click="Close_Click" Margin="2"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
        <TabControl x:Name="ProductTabControl" Margin="5" >
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Product Master [NEW]" Margin="0,5,5,0" FontSize="12"/>
                        <Button Content="x" Width="20" FontSize="14" Height="20" Margin="5,0,0,0" Click="CloseTab_Click" Background="Transparent" BorderBrush="Transparent"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="5,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1210"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="510"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Buttons with icons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5" >
                        <!-- Button with icon -->
                        <Button MaxWidth="100" Height="23" Margin="0,3,0,3">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Day4/Images/new-icon.png" Width="12" Height="12" Margin="5,0,5,0"/>
                                <TextBlock Text="NEW" Foreground="red" FontSize="13" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>

                        <Button MaxWidth="100" Height="23" Margin="0,3,0,3">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/edit-icon.png" Width="12" Height="12" Margin="5,0,5,0"/>
                                <TextBlock Text="EDIT" FontSize="13" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>

                        <Button MaxWidth="100" Height="23" Margin="0,3,0,3">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/Day4/Images/remove.png" Width="12" Height="12" Margin="5,0,5,0"/>
                                <TextBlock Text="DELETE"  FontSize="13" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>
                        <Button MaxWidth="100" Height="23" Margin="0,3,0,3">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/view.png" Width="12" Height="12" Margin="5,0,5,0"/>
                                <TextBlock Text="View"  FontSize="13" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button>

                        <Border BorderBrush="gray" BorderThickness="0,0,0.5,0" Margin="5,5"/>

                        <!-- Navigation Icons -->
                        <Button Width="30" Height="23">
                            <Image Source="Images/backward.png" Width="13" Height="13" />
                        </Button>
                        <Button Width="30" Height="23">
                            <Image Source="Images/next.png" Width="18" Height="18" />
                        </Button>
                        <Button Width="30" Height="23">
                            <Image Source="Images/previous.png" Width="18" Height="18" />
                        </Button>
                        <Button Width="30" Height="23">
                            <Image Source="Images/forward.png" Width="18" Height="18" />
                        </Button>

                        <Border BorderBrush="gray" BorderThickness="0,0,0.5,0" Margin="5,5"/>

                        <Button MaxWidth="140" Height="23">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/upload.png" Width="18" Height="18" Margin="0,0,5,0"/>
                                <TextBlock Text="Attach Document" FontSize="13" Margin="0,0,7,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row 2: Code part -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Code" FontSize="12" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox IsEnabled="False" Width="220" MaxWidth="350" Height="22" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="PM001"/>
                            <ComboBoxItem Content="Option 2"/>
                        </ComboBox>

                        <TextBlock Text="Name" FontSize="12" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox Width="350"  MaxWidth="400" Height="22" Margin="5"/>

                        <TextBlock Text="Type" FontSize="12" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox Width="220"  MaxWidth="350" Height="22" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="Inventory Item"/>
                            <ComboBoxItem Content="Option 2"/>
                        </ComboBox>

                        <TextBlock Text="Val Tech" FontSize="12" VerticalAlignment="Center" Margin="5"/>
                        <ComboBox Width="210" MaxWidth="340" Height="22" Margin="5" SelectedIndex="0">
                            <ComboBoxItem Content="Fifo"/>
                            <ComboBoxItem Content="Option 2"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 3: TabControl -->
                    <TabControl Grid.Row="2" Margin="0">
                        <!-- General Info Tab -->
                        <TabItem Header="General Info">
                            <StackPanel  Orientation="Vertical">

                                <!-- Section 1 -->
                                <Border BorderBrush="LightGray" BorderThickness="1" >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="195"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="195"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="195"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="195"/>

                                        </Grid.ColumnDefinitions>

                                        <!-- Line 1 -->
                                        <TextBlock Text="H.S. Code" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Height="22" />
                                        <TextBlock Text="Alias" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" Margin="5" Height="22"/>
                                        <TextBlock Text="Printing Name" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="5" Margin="5" Height="22"/>
                                        <TextBlock Text="Part No." Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Row="0" Grid.Column="7" Margin="5" Height="22"/>

                                        <!-- Line 2 -->
                                        <TextBlock Text="Group" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Width="180" IsEditable="True" Margin="5"/>
                                        <TextBlock Text="Add. Group" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Row="1" Grid.Column="3" Width="180" IsEditable="True" Margin="5"/>
                                        <TextBlock Text="Batch/Serial" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Row="1" Grid.Column="5" Width="180" IsEditable="True" Margin="5" SelectedIndex="0">
                                            <ComboBoxItem Content="None"/>
                                            <ComboBoxItem Content="Option 2"/>
                                        </ComboBox>
                                        <TextBlock Text="Barcode No" Grid.Row="1" Grid.Column="6" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Row="1" Grid.Column="7" Margin="5" Height="22"/>

                                        <!-- Line 3 -->
                                        <CheckBox Content="InActive" Grid.Row="2" Grid.Column="0" Margin="5"/>
                                    </Grid>
                                </Border>

                                <!-- Section 2 -->
                                <StackPanel>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 1 -->
                                        <GroupBox Grid.Column="0" Header="UOM Information" >
                                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5">
                                                <!-- Line 1 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="95"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="UOM" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                    <ComboBox Grid.Column="1" Margin="5" Width="90" Height="22"/>

                                                    <TextBlock Text="Alt.UOM" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>

                                                    <CheckBox Grid.Column="3" VerticalAlignment="Center" Margin="5"/>
                                                    <ComboBox Grid.Column="4" Margin="5" Width="80"  Height="22"/>
                                                </Grid>

                                                <!-- Line 2 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Alt Qty" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="1" Margin="5"  Height="22"/>

                                                    <TextBlock Text="Qty" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="3" Margin="5"  Height="22"/>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Column 2 -->
                                        <GroupBox Header="Price Information" Margin="2" Grid.Column="1">
                                            <StackPanel Orientation="Vertical" Margin="5">

                                                <!-- Line 1 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="190"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Buy Price" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="1" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right" />

                                                    <TextBlock Text="Margin %" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="3" Margin="5"  Height="22"  Text="0.%" TextAlignment="Right"/>

                                                    <TextBlock Text="Sales Price" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="5" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>
                                                </Grid>

                                                <!-- Line 2 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="190"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="MRP" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="1" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>

                                                    <TextBlock Text="Trade Price" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="3" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>

                                                    <TextBlock Text="M.R. Rate" Grid.Column="4" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="5" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>
                                                </Grid>

                                            </StackPanel>
                                        </GroupBox>

                                    </Grid>
                                </StackPanel>

                                <!-- Section 3: Negative Stock part -->
                                <StackPanel>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="780"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 1 -->
                                        <GroupBox Grid.Column="0" Height="60" VerticalAlignment="Top" Header="Negative Information" Margin="2">
                                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5">
                                                <!-- Line 1 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Control" Grid.Column="0" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" Width="100" Height="22" SelectedIndex="0">
                                                        <ComboBoxItem Content="Default(As per System Control)"/>
                                                        <ComboBoxItem Content="Option 2"/>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Column 2 -->
                                        <GroupBox Header="Reorder Information" Margin="2" Grid.Column="1">
                                            <StackPanel Orientation="Vertical">

                                                <!-- Line 1 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="300"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="300"/>

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Reorder Level" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="1" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>

                                                    <TextBlock Text="Reorder Qty" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="3" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>

                                                </Grid>

                                                <!-- Line 2 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="280"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="300"/>

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="LeadTime" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="1" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>

                                                    <TextBlock Text="Day(s) Max Level" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                                    <TextBox Grid.Column="3" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right"/>

                                                </Grid>

                                            </StackPanel>
                                        </GroupBox>

                                        <!-- Column 3 -->
                                        <GroupBox Header="Abbreviate Tax Information" Margin="5" Grid.Column="2">
                                            <Grid Margin="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="125"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Line 1 -->
                                                <TextBlock Text="VAT" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                <ComboBox  Grid.Row="0" Grid.Column="1"  Height="22" Margin="5" SelectedIndex="0">
                                                    <ComboBoxItem Content="Yes"/>
                                                    <ComboBoxItem Content="Option 2"/>
                                                </ComboBox>


                                                <!-- Line 2 -->
                                                <TextBlock Text="Rate" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Height="24" Margin="5" Text="13.00" TextAlignment="Right"/>
                                            </Grid>
                                        </GroupBox>


                                    </Grid>
                                </StackPanel>

                                <!--Section 4-->
                                <StackPanel >
                                    <Border BorderBrush="LightGray" BorderThickness="1">
                                        <TextBlock Text="Descriptions"  Margin="5,0,0,5"/>
                                    </Border>
                                    <TextBox Height="145" BorderThickness="2" TextWrapping="Wrap" AcceptsReturn="True" />
                                </StackPanel>

                            </StackPanel>

                        </TabItem>

                        <!--remaining tabs start-->
                        <TabItem Header="Additional Info">
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="General Leder Information" Grid.Column="0" Height="Auto" Margin="5">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Description" FontWeight="Bold" Foreground="Black" Background="LightGray"  Grid.Row="0" Grid.Column="0" Padding="3"/>
                                        <TextBlock Text="Ledger" FontWeight="Bold" Foreground="Black" Background="LightGray" Grid.Row="0" Grid.Column="1" TextAlignment="Center" Padding="3"/>
                                        <TextBlock Text="Subledger" FontWeight="Bold" Foreground="Black" Background="LightGray" Grid.Row="0" Grid.Column="2"  TextAlignment="Center" Padding="3"/>

                                        <TextBlock Text="Purchase" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="1" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Sales" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="2" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Sales Return" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="3" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Purchase Return" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="5" Grid.ColumnSpan="2"/>

                                        <TextBlock Text="Sales Expiry" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="5" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Purchase Expiry" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="6" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="6" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Store Issue" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="7" Grid.Column="1" Margin="5" Grid.ColumnSpan="2"/>

                                        <TextBlock Text="Store Return" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="8" Grid.Column="1" Margin="5" Grid.ColumnSpan="2"/>

                                        <TextBlock Text="Control A/c" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="9" Grid.Column="1" Margin="5" Grid.ColumnSpan="2"/>

                                        <TextBlock Text="Rate Difference" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="10" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="10" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Opening Stock P/L" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="11" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="11" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Closing Stok P/L" Grid.Row="12" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="12" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="12" Grid.Column="2" Margin="5"/>

                                        <TextBlock Text="Closing Stock B/S" Grid.Row="13" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="13" Grid.Column="1" Margin="5"/>
                                        <ComboBox Grid.Row="13" Grid.Column="2" Margin="5"/>


                                    </Grid>
                                </GroupBox>

                                <Grid Margin="5" Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <GroupBox Header="Vendor Information" Grid.Row="0" VerticalAlignment="Top">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="410"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Preferred Vendor" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Preferred Vendor2" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Vendor Item Name" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Vendor Item No." Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Manufacturer" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Brand" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Model" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="6" Grid.Column="1" Margin="5"/>

                                            <TextBlock Text="Rack No" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="7" Grid.Column="1" Margin="5"/>
                                        </Grid>
                                    </GroupBox>

                                    <Border BorderBrush="LightGray" BorderThickness="1" Grid.Row="1" Margin="3">
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="155"/>
                                                <ColumnDefinition Width="205"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Enable Rate in Multiple UOM" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="5"/>
                                            <TextBlock Text="Alt Qty Conversion Control" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                            <ComboBox Grid.Column="3" Margin="5" Height="22"  SelectedIndex="0">
                                                <ComboBoxItem Content="Default(As per System Control)"/>
                                                <ComboBoxItem Content="Option 2"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                        </TabItem>
                        <TabItem Header="Other Info">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="220" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Top Section -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"  Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="170" />
                                        </Grid.RowDefinitions>
