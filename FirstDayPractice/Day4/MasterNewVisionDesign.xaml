                                        <ComboBoxItem Content="Product Wise"/>
                                        <ComboBoxItem Content="Option 2"/>
                                    </ComboBox>

                                    <TextBlock Text="Free/Bonus Calcualtion Type" Grid.Column="4" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <ComboBox Grid.Column="5" IsEnabled="True" Height="22" Margin="5" SelectedIndex="0">
                                        <ComboBoxItem Content="Exact Meet"/>
                                        <ComboBoxItem Content="Option 2"/>
                                    </ComboBox>
                                </Grid>

                                <DataGrid Grid.Row="2" x:Name="BonusDataGrid" ItemsSource="{Binding BonusList}" CanUserAddRows="True" AutoGenerateColumns="False"  IsReadOnly="False"  Margin="5" Height="400"  >
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="25">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*" Header="Data From">
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding DateFrom}"  Width="202" Height="30"   BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*" Header="Data To">
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding DateTo}"  Width="202" Height="30"   BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*" Header="Slab Wise">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding SlabWise}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*" Header="Quantity">

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Quantity, StringFormat=N2}" Width="212" Height="25" BorderThickness="0" TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*" Header="Bonus/Free">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding BonusFree, StringFormat=N2}" Width="212" Height="25" BorderThickness="0"  TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Width="*" Header="InActive">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding InActive}" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>

                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Kit Info">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="25"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Effect in Sales" Grid.Column="0" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <ComboBox Grid.Column="1" IsEnabled="False" Height="22" Margin="5,5,5,5" SelectedIndex="0">
                                        <ComboBoxItem Content="Kit Item"/>
                                        <ComboBoxItem Content="Option 2"/>
                                    </ComboBox>

                                    <TextBlock Text="Display in Transaction" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <ComboBox Grid.Column="3" IsEnabled="True"  Height="22" Margin="5,5,5,5" SelectedIndex="0">
                                        <ComboBoxItem Content="Yes"/>
                                        <ComboBoxItem Content="Option 2"/>
                                    </ComboBox>

                                    <TextBlock Text="Conversion Factor" Grid.Column="4" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <TextBox Grid.Column="5" Margin="5"  Height="22"  Text="1.00" TextAlignment="Right" />

                                    <TextBlock Text="Alt Qty" Grid.Column="6" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <TextBox Grid.Column="7" Margin="5"  Height="22"  Text="0.00" TextAlignment="Right" />

                                    <TextBlock Text="Qty" Grid.Column="8" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <TextBox Grid.Column="9" Margin="5"  Height="22"  Text="1.00" TextAlignment="Right" />

                                    <TextBlock Text="Post in Transaction" Grid.Column="10" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <CheckBox Grid.Column="11" VerticalAlignment="Center" Margin="5,0,5,0"/>

                                </Grid>

                                <Grid Margin="5" Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DataGrid  Grid.Row="0" x:Name="KitDataGrid" ItemsSource="{Binding KitList}" CanUserAddRows="True" AutoGenerateColumns="False" Height="350"  IsReadOnly="False"  Margin="5">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="25">
                                                <DataGridTemplateColumn.Header>
                                                    <TextBlock Text="" />
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="*" Header="Item">
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox IsEnabled="True" SelectedItem="{Binding Item}">
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" Header="Godown">
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox IsEnabled="True" SelectedItem="{Binding Godown}">
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" Header="Alt Qty">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding AltQty, StringFormat=N2}" Width="212" Height="25" BorderThickness="0" TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" Header="UOM">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding UOM1}" Width="212" Height="25" BorderThickness="0"  TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" Header="Quantity">

                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Qty, StringFormat=N2}" Width="212" Height="25" BorderThickness="0" TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" Header="UOM">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding UOM2}" Width="212" Height="25" BorderThickness="0"  TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Width="*" Header="Description">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Description}" Width="212" Height="25" BorderThickness="0"  TextAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                        </DataGrid.Columns>

                                    </DataGrid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBox Margin="30,0,30,0" Width="150" Height="22"  Text="0.000" TextAlignment="Right" Padding="2"/>
                                        <TextBox Margin="30,0,30,0" Width="150" Height="22"  Text="0.000" TextAlignment="Right" Padding="2" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="UOM Information">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="80"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="80"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Vertical">
                                    <Border BorderBrush="LightGray" BorderThickness="1" >
                                        <TextBlock Text="Sales UOM Information" FontSize="12" VerticalAlignment="Center" Margin="5"/>
                                    </Border>
                                    <Border  BorderBrush="LightGray" BorderThickness="1" >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="295"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="290"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="295"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="UOM" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                            <ComboBox Grid.Column="1"  Height="22" Margin="5,5,5,5" >
                                            </ComboBox>
                                            <TextBlock Text="Alt. UOM"  Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                            <CheckBox Grid.Column="3" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                            <ComboBox Grid.Column="4" IsEnabled="False" Height="22" Margin="5,5,5,5" >
                                            </ComboBox>
                                            <TextBlock Text="Alt1. UOM"  Grid.Column="5" VerticalAlignment="Center" Margin="5"/>
                                            <CheckBox Grid.Column="6" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                            <ComboBox Grid.Column="7" IsEnabled="False" Height="22" Margin="5,5,5,5" >
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Vertical">
                                    <Border  BorderBrush="LightGray" BorderThickness="1" >
                                        <TextBlock Text="Purchase UOM Information" FontSize="12" VerticalAlignment="Center" Margin="5"/>
                                    </Border>
                                    <Border  BorderBrush="LightGray" BorderThickness="1" >
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="295"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="290"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="295"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="UOM" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                                            <ComboBox Grid.Column="1"  Height="22" Margin="5,5,5,5" >
                                            </ComboBox>
                                            <TextBlock Text="Alt. UOM"  Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                                            <CheckBox Grid.Column="3" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                            <ComboBox Grid.Column="4" IsEnabled="False" Height="22" Margin="5,5,5,5" >
                                            </ComboBox>
                                            <TextBlock Text="Alt1. UOM"  Grid.Column="5" VerticalAlignment="Center" Margin="5"/>
                                            <CheckBox Grid.Column="6" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                            <ComboBox Grid.Column="7"  IsEnabled="False" Height="22" Margin="5,5,5,5" >
                                            </ComboBox>


                                        </Grid>
                                    </Border>
                                </StackPanel>

                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Bottom part with Buttons -->
                    <DockPanel Grid.Row="3" LastChildFill="True" >
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                            <Button Width="100" Height="25" Margin="5" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Images/check.png" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="OK"/>
                                </StackPanel>
                            </Button>

                            <Button Width="100" Height="25" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Images/close.png" Width="16" Height="16" Margin="0,0,5,0"/>
                                    <TextBlock Text="Cancel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </DockPanel>
                </Grid>
            </TabItem>

        </TabControl>
        </Grid>
    </Grid>
</Window>
